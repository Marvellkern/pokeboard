# Firebase web app config (Project settings → Your apps → Web app). Leave empty to play locally only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_APP_ID=
# Development only:
# VITE_FIREBASE_EMULATOR=true      # use the local Firebase Emulator (npm run emulators)
# VITE_FIREBASE_TAB_IDENTITY=true  # each browser tab is its own player (test several players in one browser)
